# Server Configuration
PORT=3001
LOG_LEVEL=info

# URL prefix for sub-path deployment behind a reverse proxy.
# No trailing slash. Used by the backend (request prefix stripping),
# the frontend build (vite base) and the Traefik labels below.
# Leave empty for root deployment.
URL_PREFIX=

# Public hostname for the Traefik router (docker-compose.override.yml)
TRAEFIK_HOST=

# Database Path (inside container)
DB_PATH=/data/books.db

# Library Path (on host)
LIBRARY_PATH=./lib
