# Server Configuration
PORT=3001
LOG_LEVEL=info

# URL prefix for sub-path deployment behind a reverse proxy.
# No trailing slash. Used by the backend (request prefix stripping),
# the frontend build (vite base) and the Traefik labels below.
# Leave empty for root deployment.
URL_PREFIX=

# Public hostname for the Traefik router (docker-compose.override.yml)
TRAEFIK_HOST=

# Database Path (inside container)
DB_PATH=/data/books.db

# Library roots (on host), PATH-style list. Each root's first-level
# subdirectories are libraries (scan and serve them all).
LIBRARY_PATH=./lib

# Human-readable display names for libraries, "slug:Name,...".
# The slug is the library subdirectory name; unknown slugs are ignored.
#LIBRARY_NAMES=mylib:My Home Library,other:Public Domain

# Rescan guard: maximum percent of a library's rows a scan may tombstone
# (mark absent). A scan exceeding it fails and changes nothing.
# 100 disables the guard.
LIBRARY_MISSING_THRESHOLD=30
